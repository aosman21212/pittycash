<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_petty_cash_transaction_list" model="ir.ui.view">
        <field name="name">petty.cash.transaction.list</field>
        <field name="model">petty.cash.transaction</field>
        <field name="arch" type="xml">
            <list string="Petty Cash Transactions"
                  decoration-success="debit > 0 and credit == 0"
                  decoration-danger="credit > 0 and debit == 0">
                <field name="date"/>
                <field name="description"/>
                <field name="employee_id"/>
                <field name="fund_id" optional="hide"/>
                <field name="debit" sum="Total Debit" widget="monetary"/>
                <field name="credit" sum="Total Credit" widget="monetary"/>
                <field name="balance" widget="monetary"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="request_id" optional="hide"/>
                <field name="move_id" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_petty_cash_transaction_form" model="ir.ui.view">
        <field name="name">petty.cash.transaction.form</field>
        <field name="model">petty.cash.transaction</field>
        <field name="arch" type="xml">
            <form string="Petty Cash Transaction">
                <sheet>
                    <group>
                        <group string="Transaction Details">
                            <field name="fund_id" readonly="1"/>
                            <field name="employee_id" readonly="1"/>
                            <field name="date" readonly="1"/>
                            <field name="description" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Amounts">
                            <field name="debit" readonly="1" widget="monetary"/>
                            <field name="credit" readonly="1" widget="monetary"/>
                            <field name="balance" readonly="1" widget="monetary"/>
                        </group>
                    </group>
                    <group string="References">
                        <field name="request_id" readonly="1"/>
                        <field name="move_id" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_petty_cash_transaction_search" model="ir.ui.view">
        <field name="name">petty.cash.transaction.search</field>
        <field name="model">petty.cash.transaction</field>
        <field name="arch" type="xml">
            <search string="Petty Cash Transactions">
                <field name="description"/>
                <field name="employee_id"/>
                <field name="fund_id"/>
                <filter string="Debits (In)" name="debits" domain="[('debit', '&gt;', 0)]"/>
                <filter string="Credits (Out)" name="credits" domain="[('credit', '&gt;', 0)]"/>
                <group>
                    <filter string="Employee" name="group_employee" domain="[]" context="{'group_by': 'employee_id'}"/>
                    <filter string="Fund" name="group_fund" domain="[]" context="{'group_by': 'fund_id'}"/>
                    <filter string="Date" name="group_date" domain="[]" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_petty_cash_transaction" model="ir.actions.act_window">
        <field name="name">Petty Cash Transactions</field>
        <field name="res_model">petty.cash.transaction</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_petty_cash_transaction_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No transactions yet
            </p>
            <p>
                Transactions are created automatically when petty cash requests are approved.
            </p>
        </field>
    </record>
</odoo>
