<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_petty_cash_request_form" model="ir.ui.view">
        <field name="name">petty.cash.request.form</field>
        <field name="model">petty.cash.request</field>
        <field name="arch" type="xml">
            <form string="Petty Cash Request">
                <header>
                    <button name="action_submit" string="Submit" type="object"
                        class="btn-primary"
                        invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve" type="object"
                        class="btn-success"
                        invisible="state != 'submitted'"
                        groups="leapai_petty_cash.petty_cash_manager_group"/>
                    <button name="action_mark_paid" string="Mark as Paid" type="object"
                        class="btn-primary"
                        invisible="state != 'approved'"/>
                    <button name="action_reject" string="Reject" type="object"
                        class="btn-danger"
                        invisible="state not in ('submitted', 'approved')"
                        groups="leapai_petty_cash.petty_cash_manager_group"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object"
                        invisible="state not in ('submitted', 'rejected')"/>
                    <button name="action_view_journal_entry" string="View Journal Entry" type="object"
                        invisible="not move_id"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,paid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Request Details">
                            <field name="employee_id"/>
                            <field name="fund_id"/>
                            <field name="date"/>
                            <field name="amount" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="current_balance" readonly="1" widget="monetary"/>
                        </group>
                        <group string="Status Information">
                            <field name="approved_by" readonly="1" invisible="not approved_by"/>
                            <field name="approved_date" readonly="1" invisible="not approved_date"/>
                            <field name="paid_date" readonly="1" invisible="not paid_date"/>
                            <field name="move_id" readonly="1" invisible="not move_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="reason" placeholder="Describe the purpose of this petty cash request..." colspan="2"/>
                    </group>
                    <group invisible="state != 'rejected'">
                        <field name="rejection_reason" readonly="1" string="Rejection Reason"/>
                    </group>
                    <group>
                        <field name="notes" string="Internal Notes" placeholder="Internal notes..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_petty_cash_request_list" model="ir.ui.view">
        <field name="name">petty.cash.request.list</field>
        <field name="model">petty.cash.request</field>
        <field name="arch" type="xml">
            <list string="Petty Cash Requests"
                  decoration-info="state == 'draft'"
                  decoration-warning="state == 'submitted'"
                  decoration-success="state == 'paid'"
                  decoration-danger="state == 'rejected'">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="fund_id"/>
                <field name="date"/>
                <field name="amount" widget="monetary"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="reason"/>
                <field name="approved_by" optional="hide"/>
                <field name="state" widget="badge"
                    decoration-info="state == 'draft'"
                    decoration-warning="state == 'submitted'"
                    decoration-success="state in ('approved', 'paid')"
                    decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_petty_cash_request_kanban" model="ir.ui.view">
        <field name="name">petty.cash.request.kanban</field>
        <field name="model">petty.cash.request</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="state"/>
                <field name="amount"/>
                <field name="currency_id"/>
                <field name="employee_id"/>
                <field name="date"/>
                <field name="reason"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                </div>
                                <field name="state" widget="label_selection"
                                    options="{'classes': {'draft': 'secondary', 'submitted': 'warning', 'approved': 'success', 'paid': 'success', 'rejected': 'danger'}}"/>
                            </div>
                            <div class="o_kanban_record_body">
                                <div><i class="fa fa-user" title="Employee"/> <field name="employee_id"/></div>
                                <div><i class="fa fa-calendar" title="Date"/> <field name="date"/></div>
                                <div class="o_kanban_record_subtitle">
                                    <field name="reason" class="text-muted"/>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <strong><field name="amount" widget="monetary"/></strong>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_petty_cash_request_search" model="ir.ui.view">
        <field name="name">petty.cash.request.search</field>
        <field name="model">petty.cash.request</field>
        <field name="arch" type="xml">
            <search string="Petty Cash Requests">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="fund_id"/>
                <filter string="My Requests" name="my_requests"
                    domain="[('employee_id.user_id', '=', uid)]"/>
                <filter string="Pending Approval" name="pending_approval"
                    domain="[('state', '=', 'submitted')]"/>
                <filter string="Approved" name="approved"
                    domain="[('state', 'in', ('approved', 'paid'))]"/>
                <filter string="Paid" name="paid"
                    domain="[('state', '=', 'paid')]"/>
                <filter string="This Month" name="this_month"
                    domain="[('date', '&gt;=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Rejected" name="rejected" domain="[('state', '=', 'rejected')]"/>
                <group>
                    <filter string="Employee" name="group_employee" domain="[]" context="{'group_by': 'employee_id'}"/>
                    <filter string="Fund" name="group_fund" domain="[]" context="{'group_by': 'fund_id'}"/>
                    <filter string="Status" name="group_state" domain="[]" context="{'group_by': 'state'}"/>
                    <filter string="Date" name="group_date" domain="[]" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_petty_cash_request_all" model="ir.actions.act_window">
        <field name="name">All Petty Cash Requests</field>
        <field name="res_model">petty.cash.request</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_petty_cash_request_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No petty cash requests yet
            </p>
            <p>
                Create a petty cash request to track employee fund usage.
            </p>
        </field>
    </record>

    <record id="action_petty_cash_request_my" model="ir.actions.act_window">
        <field name="name">My Petty Cash Requests</field>
        <field name="res_model">petty.cash.request</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_petty_cash_request_search"/>
        <field name="context">{'search_default_my_requests': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No petty cash requests yet
            </p>
            <p>
                Create a petty cash request to get funds for your expenses.
            </p>
        </field>
    </record>
</odoo>
